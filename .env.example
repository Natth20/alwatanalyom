# ===================================================
# الوطن اليوم (alwatantoday.net) - Environment Configuration
# ===================================================

# Database (PostgreSQL with pgvector, pg_trgm, unaccent)
DATABASE_URL="postgresql://awt:awt_password@localhost:5432/awt?schema=public"
DATABASE_URL_READONLY="postgresql://awt_readonly:awt_readonly_password@localhost:5432/awt?schema=public"

# Redis (BullMQ, Cache, Rate limiting)
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev_meili_master_key_change_in_prod"
MEILI_SEARCH_KEY="dev_meili_search_key"

# S3 / Cloudflare R2
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET="awt-media"
S3_ACCESS_KEY="your_access_key"
S3_SECRET_KEY="your_secret_key"
S3_PUBLIC_URL="https://media.alwatantoday.net"

# Application URLs
SITE_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Authentication (Better Auth)
AUTH_SECRET="your_very_long_random_auth_secret_minimum_32_chars"

# LLM / AI (Claude API)
ANTHROPIC_API_KEY="sk-ant-api..."
AI_DAILY_BUDGET_USD="25.0"

# Financial Quotes Provider
QUOTES_PROVIDER="mock"
QUOTES_API_KEY=""

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="الوطن اليوم <noreply@alwatantoday.net>"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@alwatantoday.net"

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Monitoring
SENTRY_DSN=""

# Sports Integration (YallaSport)
YALLASPORT_API_BASE="https://api.yallasport.com"
YALLASPORT_API_KEY=""

# Cache Invalidation Token
REVALIDATE_TOKEN="internal_cache_revalidate_token_change_me"

